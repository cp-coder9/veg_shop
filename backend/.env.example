# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# SQLite (file-based, for development)
# Format: file:./relative/path/to/db
# Example: file:./prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# ==============================================
# FIREBASE (FIRESTORE) CONFIGURATION
# ==============================================
# Enable Firestore repositories in the backend.
USE_FIREBASE="true"

# Firebase service account credentials
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ==============================================
# JWT AUTHENTICATION
# ==============================================
# Secret key for signing JWT tokens (MUST be changed in production)
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production-use-openssl-rand-base64-32"

# JWT token expiration times
# Access token: Short-lived token for API requests (default: 15 minutes)
JWT_ACCESS_EXPIRY="15m"

# Refresh token: Long-lived token for getting new access tokens (default: 7 days)
JWT_REFRESH_EXPIRY="7d"

# Allow dev-login in non-development environments (DANGER: SET TO FALSE IN PRODUCTION UNLESS NEEDED FOR TESTING)
ALLOW_DEV_LOGIN="false"


# ==============================================
# SERVER CONFIGURATION
# ==============================================
# Port the backend server will listen on
PORT=3000

# Node environment (development, production, test)
NODE_ENV="development"

# CORS allowed origins (comma-separated for multiple origins)
# Example: http://localhost:5173,http://localhost:3000
CORS_ORIGIN="http://localhost:5173"

# ==============================================
# WHATSAPP BUSINESS API
# ==============================================
# WhatsApp Business API endpoint URL
# Get from: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"

# WhatsApp Business API access token
# Get from: Facebook Developer Console > WhatsApp > API Setup
WHATSAPP_API_TOKEN=""

# WhatsApp Phone Number ID
# Get from: Facebook Developer Console > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""

# ==============================================
# EMAIL SERVICE (SMTP)
# ==============================================
# SMTP server host
SMTP_HOST="mail.ourharvesttote.store"

# SMTP server port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# SMTP username
SMTP_USER="noreply@ourharvesttote.store"

# SMTP password (provided by user)
SMTP_PASS="noreply@outharvesttote"

# SMTP secure connection (ssl or tls)
SMTP_SECURE="ssl"

# Verified sender email address
SMTP_FROM_EMAIL="noreply@ourharvesttote.store"

# Verified sender name
SMTP_FROM_NAME="Our Harvest Tote"

# ==============================================
# FILE STORAGE
# ==============================================
# Local file storage path for uploads (PDFs, images)
# For production, consider using cloud storage (S3, Google Cloud Storage)
FILE_STORAGE_PATH="./uploads"

# ==============================================
# OPTIONAL: RATE LIMITING
# ==============================================
# Maximum verification codes per hour per contact
RATE_LIMIT_VERIFICATION_CODES=3

# Maximum API requests per minute per user
RATE_LIMIT_API_REQUESTS=100

# Maximum login attempts per hour per contact
RATE_LIMIT_LOGIN_ATTEMPTS=5

# ==============================================
# YOCO PAYMENT GATEWAY
# ==============================================
# Yoco API keys for payment processing
# Get from: https://business.yoco.com/portal/settings/api-keys

# Secret key for server-side operations (NEVER expose to frontend)
# Use sk_test_xxx for testing, sk_live_xxx for production
YOCO_SECRET_KEY=

# Public key for client-side SDK (safe to expose in frontend)
# Use pk_test_xxx for testing, pk_live_xxx for production
YOCO_PUBLIC_KEY=

# Webhook secret for verifying Yoco webhook signatures
# Get from: https://business.yoco.com/portal/settings/webhooks
YOCO_WEBHOOK_SECRET=
