generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  phone              String?   @unique
  email              String?   @unique
  password           String?   // Hashed password for email login
  name               String
  address            String?
  deliveryPreference String    @default("delivery")
  role               String    @default("customer")
  status             String    @default("active")
  birthday           DateTime?
  loyaltyPoints      Int       @default(0)
  popiConsentGiven   Boolean   @default(false)
  popiConsentDate    DateTime?
  popiConsentVersion String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders        Order[]
  invoices      Invoice[] @relation("CustomerInvoices")
  payments      Payment[]
  credits       Credit[]
  notifications Notification[]
  
  // Driver relations
  driverOrders  Order[]     @relation("DriverOrders")
  driverLogs    DriverLog[]

  // Packer relations
  packerOrders  Order[]     @relation("PackerOrders")

  // Poll Items
  pollItems     PollItem[]  @relation("CustomerPollItems")

  @@map("users")
}

model ProductCategory {
  id          String    @id @default(uuid())
  key         String    @unique
  label       String
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String    @id @default(cuid())
  name        String    @unique
  price       Decimal 
  category    String
  unit        String
  description String?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isSeasonal  Boolean  @default(false)
  isPerishable Boolean @default(false) // Determines delivery grouping eligibility
  packingType String   @default("box") // "box", "bag", "fridge", "freezer"
  deliveryDay String?  // "Wednesday" | "Friday" - delivery day for the product
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryRef        ProductCategory? @relation(fields: [category], references: [key])
  orderItems         OrderItem[]
  priceHistory       PriceHistory[]
  weeklyAvailability WeeklyAvailability[]
  pollItems          PollItem[] @relation("ProductPollItems")

  @@map("products")
  @@index([supplierId])
}

// Weekly availability toggle — admin confirms per-week product availability (Mon/Tue)
model WeeklyAvailability {
  id          String    @id @default(uuid())
  productId   String
  weekStart   DateTime  // Monday of the target week (ISO date, time 00:00:00)
  isAvailable Boolean   @default(true)
  confirmedBy String?   // Admin user ID who confirmed
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, weekStart])
  @@index([weekStart])
  @@map("weekly_availability")
}

model Supplier {
  id          String    @id @default(cuid())
  name        String    @unique
  contactInfo String?
  isAvailable Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("suppliers")
}

model Order {
  id                  String    @id @default(uuid())
  customerId          String
  deliveryDate        DateTime
  deliveryMethod      String    @default("delivery")
  deliveryAddress     String?
  specialInstructions String?
  deliveryFees        Decimal   @default(0)
  status              String    @default("pending")
  coolerBagOption     Boolean   @default(false)
  coolerBagStatus     String    @default("none") // "none", "taken", "returned"
  groupDelivery       Boolean   @default(false)
  deliveryInstruction String?   // "door", "hand_to_me", "inside_fridge", "inside_freezer"
  packerSignature     String?
  deliveryNotes       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer User        @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  invoice  Invoice?

  // Driver fields
  driverId      String?
  driver        User?   @relation("DriverOrders", fields: [driverId], references: [id])
  deliveryProof String? // "handed_to_client" | "left_at_door"
  driverNotes   String?

  // Packer fields
  packerId      String?
  packer        User?   @relation("PackerOrders", fields: [packerId], references: [id])
  packerNotes   String?

  @@index([customerId])
  @@index([deliveryDate])
  @@index([status])
  @@index([driverId])
  @@index([packerId])
  @@map("orders")
}

model DriverLog {
  id         String   @id @default(uuid())
  driverId   String
  date       DateTime @default(now())
  startKm    Decimal
  endKm      Decimal?
  vehicleReg String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  driver User @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([date])
  @@map("driver_logs")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  priceAtOrder Decimal

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Invoice {
  id            String    @id @default(uuid())
  orderId       String    @unique
  customerId    String
  subtotal      Decimal
  creditApplied Decimal   @default(0)
  total         Decimal
  status        String    @default("unpaid")
  pdfUrl        String?
  type          String    @default("proforma") // "proforma" | "final"
  finalisedAt   DateTime?
  finalisedBy   String?   // Admin user ID
  createdAt     DateTime  @default(now())
  dueDate       DateTime

  order    Order     @relation(fields: [orderId], references: [id])
  customer User      @relation("CustomerInvoices", fields: [customerId], references: [id])
  payments Payment[]
  pollItems PollItem[] @relation("InvoicePollItems")

  @@index([customerId])
  @@index([status])
  @@index([type])
  @@map("invoices")
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  customerId  String
  amount      Decimal
  method      String
  paymentDate DateTime
  notes       String?

  invoice  Invoice @relation(fields: [invoiceId], references: [id])
  customer User    @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("payments")
}

model Credit {
  id         String   @id @default(uuid())
  customerId String
  amount     Decimal
  reason     String
  type       String
  createdAt  DateTime @default(now())

  customer User @relation(fields: [customerId], references: [id])

  @@map("credits")
}

model PriceHistory {
  id            String   @id @default(uuid())
  productId     String
  price         Decimal
  effectiveDate DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@map("price_history")
}

model Notification {
  id         String    @id @default(uuid())
  customerId String
  type       String
  method     String
  content    String
  status     String    @default("pending")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  customer User @relation(fields: [customerId], references: [id])

  @@map("notifications")
}

model VerificationCode {
  id        String   @id @default(uuid())
  contact   String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([contact])
  @@map("verification_codes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// Stock Order - tracks orders placed to suppliers based on weekly collation
model StockOrder {
  id                String    @id @default(uuid())
  weekStartDate     DateTime
  supplierId        String?
  supplierName      String?
  status            String    @default("pending") // "pending", "partial", "received", "fulfilled"
  totalItems        Int       @default(0)
  totalOrdered      Decimal   @default(0)
  totalReceived     Decimal   @default(0)
  totalCredits      Decimal   @default(0)
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items             StockOrderItem[]
  history           WeeklyCollationHistory[]

  @@index([weekStartDate])
  @@index([status])
  @@map("stock_orders")
}

// Individual items in a stock order
model StockOrderItem {
  id              String   @id @default(uuid())
  stockOrderId    String
  productId       String
  productName     String
  category        String
  unit            String
  orderedQuantity Int
  receivedQuantity Int     @default(0)
  pricePerUnit    Decimal  @default(0)
  isShort         Boolean  @default(false)
  shortQuantity   Int      @default(0)
  creditAmount    Decimal  @default(0)
  customerId      String?  // If this item is for a specific customer's order
  orderId         String?  // Reference to the original order
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stockOrder      StockOrder @relation(fields: [stockOrderId], references: [id], onDelete: Cascade)

  @@index([stockOrderId])
  @@index([productId])
  @@map("stock_order_items")
}

// History of weekly collation reports
model WeeklyCollationHistory {
  id              String    @id @default(uuid())
  stockOrderId    String?
  weekStartDate   DateTime
  weekEndDate     DateTime
  reportData      String    // JSON string of the collation report
  totalProducts   Int       @default(0)
  totalOrders     Int       @default(0)
  totalValue      Decimal   @default(0)
  status          String    @default("generated") // "generated", "sent", "received", "fulfilled"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stockOrder      StockOrder? @relation(fields: [stockOrderId], references: [id])

  @@index([weekStartDate])
  @@index([status])
  @@map("weekly_collation_history")
}

// WhatsApp Poll items recorded by admin
model PollItem {
  id          String   @id @default(uuid())
  customerId  String
  productId   String
  quantity    Int
  price       Decimal 
  status      String   @default("pending") // "pending" | "invoiced"
  invoiceId   String?  // Reference to the invoice it eventually gets added to
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    User     @relation("CustomerPollItems", fields: [customerId], references: [id])
  product     Product  @relation("ProductPollItems", fields: [productId], references: [id])
  invoice     Invoice? @relation("InvoicePollItems", fields: [invoiceId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("poll_items")
}
