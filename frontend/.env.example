# ==============================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================

# Backend API URL
# Development: http://localhost:3000
# Production: https://api.yourdomain.com
# ==============================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================
# Vite uses VITE_ prefix for environment variables
# These are exposed to the client-side code

# ==============================================
# API CONFIGURATION
# ==============================================
# Backend API base URL
# Development: http://localhost:3000
# Production: https://api.organicveg.com
VITE_API_URL=http://localhost:3000

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Application name (displayed in UI)
VITE_APP_NAME="Organic Veg Order Management"

# Application version
VITE_APP_VERSION="1.0.0"

# ==============================================
# FEATURE FLAGS (Optional)
# ==============================================
# Enable/disable features
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_DEV_LOGIN=false


# Application Name (displayed in UI)
VITE_APP_NAME="Organic Veg Shop"

# Enable debug mode (shows additional logging in console)
VITE_DEBUG=false

# ==============================================
# YOCO PAYMENT GATEWAY
# ==============================================
# Yoco public key for client-side SDK
# Get from: https://business.yoco.com/portal/settings/api-keys
# Use pk_test_xxx for testing, pk_live_xxx for production
VITE_YOCO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxx
