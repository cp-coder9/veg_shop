# ===========================================
# VEG SHOP PHP BACKEND - ENVIRONMENT CONFIG
# ===========================================
# Copy this file to .env and configure values

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=veg_shop
DB_USER=root
DB_PASS=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
ALLOW_DEV_LOGIN=false


# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# Notification Services (Optional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# SMTP Configuration
SMTP_HOST=mail.ourharvesttote.store
SMTP_PORT=465
SMTP_USER=noreply@ourharvesttote.store
SMTP_PASS=noreply@outharvesttote
SMTP_FROM_EMAIL=noreply@ourharvesttote.store
SMTP_FROM_NAME="Our Harvest Tote"
